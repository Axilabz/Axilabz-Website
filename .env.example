# Copy to .env (local) or configure as Worker variables/secrets (production).
# Nothing here is committed with real values.

# --- Public (build-time, safe to expose) ---------------------------------
# Verified production origin, no trailing slash. Drives canonical URLs, Open
# Graph URLs, JSON-LD, robots.txt and sitemap.xml. When unset, the sitemap
# returns 404 and robots.txt omits the Sitemap line, so non-production URLs are
# never published.
NEXT_PUBLIC_SITE_URL=

# Optional. Verified public contact email (footer, privacy page, JSON-LD).
NEXT_PUBLIC_CONTACT_EMAIL=
# Where job applications go (the Apply button opens the visitor mail app addressed to this). Defaults to axilabzoff@gmail.com
NEXT_PUBLIC_CAREERS_EMAIL=

# Optional. Google Analytics 4 measurement ID. Loaded only after the visitor
# accepts the consent banner. Unset = no analytics, no banner.
NEXT_PUBLIC_GA_ID=

# --- Secrets (Worker secrets only; NEVER prefix with NEXT_PUBLIC_) --------
# Transactional email via Resend (https://resend.com). RESEND_API_KEY and CONTACT_FROM are required
# for notifications; without them enquiries are still stored and marked
# notify_status = 'skipped'.
RESEND_API_KEY=
# Verified sender, e.g. "Axilabz Website <noreply@your-verified-domain>"
CONTACT_FROM=
# Inbox(es) that receive enquiries, comma-separated. Optional: defaults to axilabzoffl@gmail.com.
CONTACT_NOTIFY_TO=axilabzoffl@gmail.com

# Salt for hashing visitor IPs used by rate limiting. Use a long random string.
CONTACT_HASH_SALT=
